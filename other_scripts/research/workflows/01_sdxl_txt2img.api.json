{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "1. 체크포인트 로드" },
    "inputs": { "ckpt_name": "Illustrious-XL-v0.1.safetensors" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "2. Positive 프롬프트" },
    "inputs": {
      "text": "masterpiece, best quality, very aesthetic, absurdres, 2girls, one girl with long red hair and blue dress, another girl with short black hair and white shirt, standing side by side, simple background",
      "clip": ["1", 1]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "3. Negative 프롬프트" },
    "inputs": {
      "text": "lowres, worst quality, low quality, bad anatomy, bad hands, text, watermark, signature, jpeg artifacts, extra digits, fewer digits",
      "clip": ["1", 1]
    }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "4. 빈 Latent (SDXL 1024)" },
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "5": {
    "class_type": "KSampler",
    "_meta": { "title": "5. 샘플링" },
    "inputs": {
      "seed": 20260912,
      "steps": 28,
      "cfg": 6.0,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "_meta": { "title": "6. Latent -> 이미지" },
    "inputs": { "samples": ["5", 0], "vae": ["1", 2] }
  },
  "7": {
    "class_type": "SaveImage",
    "_meta": { "title": "7. 저장" },
    "inputs": { "filename_prefix": "baseline_2girls", "images": ["6", 0] }
  }
}
